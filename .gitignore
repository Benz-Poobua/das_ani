# Python cache / build files
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.build/

# Jupyter Notebook
.ipynb_checkpoints/

# macOS system files
.DS_Store

# Images
*.png
!fig/*.png

# Data files
*.csv
*.npy
*.npz
*.h5
*.json

# Ignore everything inside these folders
geometry/*
data/*
results/*

# But keep the placeholder file so the folder exists in Git
!geometry/.gitkeep
!data/preprocessed/.gitkeep
!data/ncf/.gitkeep
!data/synthetic/.gitkeep

# Virtual environments / local installs (CRITICAL)
.venv/
venv/
env/
ENV/

# If we accidentally created a venv inside the repo root (common on mac)
bin/
lib/
Lib/
Scripts/
pyvenv.cfg

# If we created a venv inside your package folder
das_ani/bin/
das_ani/lib/
das_ani/Lib/
das_ani/Scripts/
das_ani/pyvenv.cfg

# More accidental venv folders inside package
das_ani/share/
das_ani/include/
